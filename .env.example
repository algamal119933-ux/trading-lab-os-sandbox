# Pinned initial image. Change to 2026.7_freqai only when you intentionally start FreqAI work.
FREQTRADE_IMAGE=freqtradeorg/freqtrade:2026.7

# Local-only API credentials. CHANGE THESE before first run.
FREQTRADE_API_USER=freqtrader
FREQTRADE_API_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
FREQTRADE_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
FREQTRADE_WS_TOKEN=CHANGE_ME_RANDOM_WS_TOKEN

# Grafana local login. CHANGE THIS.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
