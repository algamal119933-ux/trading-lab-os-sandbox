{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "charters/research_program.schema.json",
  "title": "CEA-1 precommitted research program (AUTH-2 structure)",
  "description": "docs/governance/CONTINUOUS_EXECUTION_AUTHORITY_1.md §12. Structure only: no program instance exists until the Owner merges one at charters/programs/<PROGRAM_ID>.json. Everything that could be chosen after seeing a result is fixed here first: the DAG, every preregistration and its hash, the N law, the caps, the holdout law and the judge's hashes. Edges may be conditioned only on terminal states. .github/gates/check_research_program.py enforces what JSON Schema cannot (hashes, commit order).",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "version", "status", "families", "dataset_lock", "development_window", "holdout_law",
               "frozen_hashes", "n_law", "caps", "dag", "null_calibration_first", "stop_rules", "terminal"],
  "properties": {
    "program_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ACTIVE", "SUSPENDED", "CLOSED"]},
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "hypothesis_class", "inherited_n"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hypothesis_class": {"type": "string", "minLength": 1},
          "inherited_n": {"type": "integer", "minimum": 0}
        }
      }
    },
    "dataset_lock": {"type": "string", "pattern": "^research/datasets/[A-Za-z0-9_.-]+\\.lock\\.json$"},
    "development_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "holdout_law": {"type": "string", "minLength": 1},
    "frozen_hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["funnel_law", "funnel_py", "multiple_testing_py", "config_n_py"],
      "properties": {
        "funnel_law": {"$ref": "#/$defs/pinned"},
        "funnel_py": {"$ref": "#/$defs/pinned"},
        "multiple_testing_py": {"$ref": "#/$defs/pinned"},
        "config_n_py": {"$ref": "#/$defs/pinned"}
      }
    },
    "n_law": {"type": "string", "minLength": 1},
    "caps": {
      "type": "object", "additionalProperties": false,
      "required": ["configurations", "scientific_trial_ids", "calibration_trial_ids", "engine_invocations", "hyperopt"],
      "properties": {
        "configurations": {"type": "integer", "minimum": 1},
        "scientific_trial_ids": {"type": "integer", "minimum": 1},
        "calibration_trial_ids": {"type": "integer", "minimum": 0},
        "engine_invocations": {"type": "integer", "minimum": 1},
        "hyperopt": {"const": 0}
      }
    },
    "dag": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "edges", "max_depth", "max_nodes"],
      "properties": {
        "nodes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "trial_id", "kind", "prereg_path", "prereg_sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "trial_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["NULL_CALIBRATION", "SCIENTIFIC"]},
              "prereg_path": {"type": "string", "minLength": 1},
              "prereg_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "on", "to"],
            "properties": {
              "from": {"type": "string"},
              "on": {"enum": ["REJECTED", "SURVIVED", "INCONCLUSIVE"]},
              "to": {"type": "string"}
            }
          }
        },
        "max_depth": {"type": "integer", "minimum": 1},
        "max_nodes": {"type": "integer", "minimum": 1}
      }
    },
    "null_calibration_first": {"const": true},
    "stop_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "terminal": {"const": "closure_record"}
  },
  "$defs": {
    "pinned": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
