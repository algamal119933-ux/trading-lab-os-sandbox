{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research/auth2/prereg.schema.json",
  "title": "AUTH-2 node preregistration (auth2-prereg-1.0.0)",
  "description": "One node of AUTH-2-DISCOVERY-QUALIFICATION-1 (research/auth2/FUNNEL_LAW_2.md). Everything a node reads that could be chosen after a result is fixed here and hashed into the program charter: the laws it applies, the dataset lock, the engine identity, the windows, the configurations, every gate threshold, the calibration edge, the compute plan and the sha256 of every AUTH-2 code file. research/auth2/make_preregs.py writes every instance and --check proves the committed files equal what the code and records produce; research/auth2/run_node.py refuses a node whose code or thresholds differ from its preregistration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program_id", "node_id", "trial_id", "kind", "family", "purpose",
               "funnel_law", "dataset_lock", "engine", "windows", "configurations", "thresholds",
               "compute", "predecessors", "terminal_states", "code_sha256", "requirements",
               "disclosures", "dry_run", "real_money_authorized", "hyperopt", "llm_agent_tokens"],
  "properties": {
    "schema_version": {"const": "auth2-prereg-1.0.0"},
    "program_id": {"const": "AUTH-2-DISCOVERY-QUALIFICATION-1"},
    "node_id": {"enum": ["D0", "CAL-A1", "CAL-A2", "CAL-A3", "PC-A1", "PC-A2", "PC-A3", "N-A1", "N-A2", "N-A3",
                         "A1", "A2", "A3", "HOLM", "SC-A1", "SC-A2", "SC-A3"]},
    "trial_id": {"type": "string", "pattern": "^TRIAL-AUTH2-[A-Z0-9-]+$"},
    "kind": {"enum": ["DATA_LOCK", "CALIBRATION_STAT", "POSITIVE_CONTROL", "NULL_CALIBRATION", "SCIENTIFIC",
                      "HOLM", "SECONDARY_CONFIRM"]},
    "family": {"enum": ["A1", "A2", "A3", null]},
    "purpose": {"type": "string", "minLength": 20},
    "funnel_law": {"$ref": "#/$defs/pinned"},
    "dataset_lock": {"$ref": "#/$defs/pinned"},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["image", "launcher", "strategy", "disclosed_engine_patches", "timeframe"],
      "properties": {
        "image": {"const": "freqtradeorg/freqtrade:2026.7"},
        "launcher": {"$ref": "#/$defs/pinned"},
        "strategy": {"$ref": "#/$defs/pinned"},
        "disclosed_engine_patches": {"type": "array", "items": {"type": "string"}},
        "timeframe": {"const": "4h"}
      }
    },
    "windows": {
      "type": "object", "additionalProperties": false, "required": ["scored", "secondary"],
      "properties": {
        "scored": {"$ref": "#/$defs/window"},
        "secondary": {"$ref": "#/$defs/window"}
      }
    },
    "configurations": {"type": "object"},
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["delta", "edge", "true_delta", "first_seed", "years", "record", "generator"],
      "properties": {
        "delta": {"type": "number"},
        "edge": {"type": "number", "minimum": 0},
        "true_delta": {"type": "number"},
        "first_seed": {"type": "integer"},
        "years": {"const": 200},
        "record": {"$ref": "#/$defs/pinned"},
        "generator": {"type": "object"}
      }
    },
    "thresholds": {"type": "object"},
    "compute": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_minutes", "parts", "planned_engine_invocations"],
      "properties": {
        "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 360},
        "parts": {"enum": [1, 2]},
        "planned_engine_invocations": {"type": "integer", "minimum": 0}
      }
    },
    "predecessors": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["node", "on"],
                "properties": {"node": {"type": "string"}, "on": {"type": "array", "items": {"type": "string"}}}}
    },
    "terminal_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "code_sha256": {"type": "object", "minProperties": 1,
                    "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "requirements": {"$ref": "#/$defs/pinned"},
    "disclosures": {"type": "array", "items": {"type": "string"}},
    "dry_run": {"const": true},
    "real_money_authorized": {"const": false},
    "hyperopt": {"const": 0},
    "llm_agent_tokens": {"const": 0}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"enum": ["CALIBRATION_STAT", "POSITIVE_CONTROL"]}}},
     "then": {"required": ["calibration"]}},
    {"if": {"properties": {"kind": {"enum": ["DATA_LOCK", "HOLM"]}}},
     "then": {"properties": {"family": {"const": null}}},
     "else": {"properties": {"family": {"enum": ["A1", "A2", "A3"]}}}}
  ],
  "$defs": {
    "pinned": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["start_utc", "end_utc"],
      "properties": {
        "start_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T00:00:00Z$"},
        "end_utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T00:00:00Z$"}
      }
    }
  }
}
